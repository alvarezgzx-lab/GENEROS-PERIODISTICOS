{
  "name": "learning-lab-clase-muestra",
  "private": true,
  "version": "1.0.0",
  "description": "A Learning Lab · Clase muestra: Los géneros periodísticos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "extract": "tsx scripts/extract-content.ts",
    "copy-qr": "tsx scripts/copy-qr.ts",
    "dev": "vite",
    "build": "npm run extract && npm run copy-qr && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run extract && npm run lint && npm run test && npm run build && npm run test:e2e",
    "decode-qr": "tsx scripts/decode-qr.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
